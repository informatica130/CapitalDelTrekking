---
import FichaNegocio from '../../components/FichaNegocio.astro';
import { alojamientos, url, type Negocio } from '../../scripts/datos';
export function getStaticPaths() { return alojamientos.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props as { n: Negocio };
---
<FichaNegocio n={n} zona="alojamientos" propia={url.alojamiento(n.slug)} listado={{ url: '/planifica-donde-dormir/', texto: 'Dónde dormir' }} />
