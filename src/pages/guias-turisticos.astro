---
import Base from '../layouts/Base.astro';
import Heroe from '../components/Heroe.astro';
import Icono from '../components/Icono.astro';
import Filtros from '../components/Filtros.astro';
import { guias, unicos } from '../scripts/datos';
const img = '/media/2024/11/3.01salto-chufquen.jpg';
const iniciales = (n: string) => n.split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
const esp = (e: string) => e.split(',').map((x) => x.trim()).filter(Boolean);
---
<Base titulo="Guías turísticos" zona="guias" descripcion="Guías locales de montaña, trekking, escalada, kayak y nieve en Melipeuco." imagen={img}>
  <Heroe titulo="Guías" destacado="turísticos" zona="guias" imagen={img} migas={[{ texto: 'Guías turísticos' }]} bajada={`${guias.length} guías locales para acompañarte en montaña, ríos y nieve.`} />
  <section class="seccion" style="padding-top:40px">
    <div class="contenedor">
      <Filtros contenedor="lista-guias" letra={5} vista={false} opciones={[{ clave: 'esp', etiqueta: 'Especialidad', valores: unicos(guias.map((g) => g.especialidad)) }]} />
      <div class="guias" id="lista-guias">
        {guias.map((g, i) => (
          <article class="guia revelar" id={g.slug} data-item data-esp={esp(g.especialidad).join('|')} style={`--d:${i % 3}`}>
            <div class="guia__foto">{g.foto ? <img src={g.foto} alt={g.nombre} loading="lazy" /> : iniciales(g.nombre)}</div>
            <div>
              <span class="chip">{g.especialidad}</span>
              <h3>{g.nombre}</h3>
              {g.direccion && <p><b>Dirección:</b> {g.direccion}</p>}
              {g.certificaciones && <p><b>Certificaciones:</b> {g.certificaciones}</p>}
              <div class="redes">
                {g.telefono && <a href={`tel:${g.telefono}`} aria-label={`Llamar a ${g.nombre}`}><Icono nombre="telefono" /></a>}
                {g.whatsapp && <a href={g.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icono nombre="whatsapp" /></a>}
                {g.email && <a href={`mailto:${g.email}`} aria-label="Correo"><Icono nombre="email" /></a>}
                {g.instagram && <a href={g.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icono nombre="instagram" /></a>}
                {g.facebook && <a href={g.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icono nombre="facebook" /></a>}
                {g.web && <a href={g.web} target="_blank" rel="noopener" aria-label="Sitio web"><Icono nombre="web" /></a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
