---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { inicio, porSlug, rutas, actividades, alojamientos, operadores, servicios, guias, noticias, NIVELES, NIVEL_TEXTO, url } from '../scripts/datos';

const destacadas = inicio.rutas_destacadas.map((s) => porSlug.rutas.get(s)).filter(Boolean).slice(0, 4);
const imperdibles = inicio.imperdibles.map((s) => porSlug.actividades.get(s)).filter(Boolean).slice(0, 4);
const fotoNivel = (n: string) => rutas.find((r) => r.interes === n && r.imagen)?.imagen ?? '';
const fotoDe = (lista: { imagen: string }[]) => lista.find((x) => x.imagen)?.imagen ?? '';
const servTuristicos = [
  { titulo: 'Dónde comer', url: '/gastronomia/', icono: 'plato', imagen: fotoDe(servicios.filter((s) => s.seccion === 'gastronomia')), n: servicios.filter((s) => s.seccion === 'gastronomia').length },
  { titulo: 'Guías turísticos', url: '/guias-turisticos/', icono: 'persona', imagen: '/media/2024/11/3.01salto-chufquen.jpg', n: guias.length },
  { titulo: 'Dónde dormir', url: '/planifica-donde-dormir/', icono: 'cama', imagen: fotoDe(alojamientos), n: alojamientos.length },
  { titulo: 'Tour operadores', url: '/operadores-turisticos/', icono: 'brujula', imagen: fotoDe(operadores), n: operadores.length },
];
const fecha = (f: string) => new Date(f + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="heroe heroe--alto" aria-label="Bienvenida">
    <div class="carrusel" id="carrusel">
      {inicio.slides.map((src, i) => <img src={src} alt="" class={i === 0 ? 'activa' : ''} fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} />)}
    </div>
    <div class="contenedor">
      <span class="logo-brillo"><img class="heroe__logo logo-anim" src="/media/2025/05/logo-melipeuco-capital-del-trekking_Mesa-de-trabajo-1.svg" alt="Melipeuco Capital del Trekking" width="520" height="130" /></span>
      <p class="bajada revelar visible">3 volcanes, glaciares milenarios, bosques de araucarias y {rutas.length} rutas de trekking en el corazón de la Araucanía Andina.</p>
      <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
        <a class="btn" href="/rutas-de-trekking/">Explorar rutas <Icono nombre="flecha" /></a>
        <a class="btn btn--borde" href="/mapa/">Ver mapa de senderos</a>
      </p>
    </div>
    <div class="carrusel__puntos" id="puntos">
      {inicio.slides.map((_, i) => <button type="button" class={i === 0 ? 'activa' : ''} aria-label={`Foto ${i + 1}`}></button>)}
    </div>
    <a href="#descubre" class="scroll-hint" aria-label="Bajar"><Icono nombre="abajo" /></a>
  </section>

  <section class="seccion" id="descubre">
    <div class="contenedor">
      <div class="titulo-seccion revelar">
        <span class="antetitulo">Descubre</span>
        <h2>{rutas.length} rutas de trekking</h2>
        <p>Que te permitirán recorrer volcanes imponentes, bosques de araucarias y glaciares milenarios.</p>
      </div>
      <div class="grilla grilla--4">
        {destacadas.map((r, i) => (
          <a href={url.ruta(r!.slug)} class={`tarjeta-foto revelar revelar-d${i}`}>
            {r!.imagen && <img src={r!.imagen} alt="" loading="lazy" />}
            <span class={`etiqueta etiqueta--${r!.interes}`}>{r!.interes}</span>
            <div class="tarjeta-foto__txt"><h3>{r!.titulo}</h3><p>{r!.extracto}</p></div>
          </a>
        ))}
      </div>
      <p class="centro"><a class="btn btn--verde" href="/rutas-de-trekking/">Todas las rutas <Icono nombre="flecha" /></a></p>
    </div>
  </section>

  <section class="seccion seccion--oscura">
    <div class="contenedor">
      <div class="titulo-seccion revelar">
        <span class="antetitulo">Trekking para todas y todos</span>
        <h2>Encontrarás rutas de diferentes niveles de dificultad… <strong>hay una para ti</strong></h2>
      </div>
      <div class="niveles">
        {NIVELES.map((n, i) => (
          <a class={`nivel nivel--${n} revelar revelar-d${i}`} href={`/rutas-de-trekking/?interes=${n}`}>
            {fotoNivel(n) && <img src={fotoNivel(n)} alt="" loading="lazy" />}
            <span class="montes">{Array.from({ length: i + 1 }).map(() => <Icono nombre="montana" />)}</span>
            <h3>{n}</h3>
            <p>{NIVEL_TEXTO[n]}</p>
            <p style="margin-top:10px;font-weight:700">{rutas.filter((r) => r.interes === n).length} rutas →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="titulo-seccion revelar">
        <span class="antetitulo">Imperdibles</span>
        <h2>Hay lugares que simplemente <strong>no puedes dejar de visitar</strong></h2>
      </div>
      <div class="grilla grilla--4">
        {imperdibles.map((a, i) => (
          <a href={url.actividad(a!.slug)} class={`tarjeta-foto revelar revelar-d${i}`}>
            {a!.imagen && <img src={a!.imagen} alt="" loading="lazy" />}
            <span class="etiqueta">{a!.tipo}</span>
            <div class="tarjeta-foto__txt"><h3>{a!.titulo}</h3><p>{a!.extracto}</p></div>
          </a>
        ))}
      </div>
      <p class="centro"><a class="btn btn--verde" href="/que-hacer/">Todas las actividades <Icono nombre="flecha" /></a></p>
    </div>
  </section>

  <section class="seccion seccion--bosque">
    <div class="contenedor">
      <div class="cifras revelar">
        <div class="cifra"><b data-contar="3">3</b><span>volcanes</span></div>
        <div class="cifra"><b data-contar="250">250</b><span>km de senderos</span></div>
        <div class="cifra"><b data-contar={rutas.length}>{rutas.length}</b><span>rutas de trekking</span></div>
        <div class="cifra"><b data-contar="45" data-sufijo="%">45%</b><span>de áreas silvestres protegidas</span></div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="titulo-seccion revelar">
        <span class="antetitulo">Servicios turísticos</span>
        <h2>Una oferta diversa para tu estadía en Melipeuco</h2>
      </div>
      <div class="grilla grilla--4">
        {servTuristicos.map((s) => (
          <Tarjeta url={s.url} titulo={s.titulo} imagen={s.imagen} icono={s.icono} chips={[{ t: `${s.n} registros`, c: 'chip--sol' }]} />
        ))}
      </div>
    </div>
  </section>

  {noticias.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <div class="titulo-seccion revelar">
          <span class="antetitulo">Actualidad</span>
          <h2>Noticias de Melipeuco</h2>
        </div>
        <div class="grilla">
          {noticias.slice(0, 3).map((n) => (
            <Tarjeta url={url.noticia(n.slug)} titulo={n.titulo} imagen={n.imagen} texto={n.extracto} icono="camara" chips={[{ t: fecha(n.fecha) }, { t: n.categoria, c: 'chip--verde' }]} />
          ))}
        </div>
        <p class="centro"><a class="btn btn--verde" href="/noticias/">Ver todas las noticias</a></p>
      </div>
    </section>
  )}

  <script>
    // Carrusel de fotos del inicio
    const fotos = [...document.querySelectorAll<HTMLImageElement>('#carrusel img')];
    const puntos = [...document.querySelectorAll<HTMLButtonElement>('#puntos button')];
    let actual = 0;
    let timer: number | undefined;
    const ir = (n: number) => {
      fotos[actual]?.classList.remove('activa'); puntos[actual]?.classList.remove('activa');
      actual = (n + fotos.length) % fotos.length;
      const img = fotos[actual];
      img.classList.remove('activa'); void img.offsetWidth; img.classList.add('activa');
      puntos[actual]?.classList.add('activa');
    };
    const iniciar = () => { clearInterval(timer); timer = window.setInterval(() => ir(actual + 1), 6500); };
    puntos.forEach((p, i) => p.addEventListener('click', () => { ir(i); iniciar(); }));
    if (fotos.length > 1) iniciar();

    // Contadores animados
    const contar = (el: HTMLElement) => {
      const fin = Number(el.dataset.contar); const suf = el.dataset.sufijo ?? '';
      const t0 = performance.now();
      const paso = (t: number) => {
        const p = Math.min(1, (t - t0) / 1600);
        el.textContent = Math.round(fin * (1 - Math.pow(1 - p, 3))) + suf;
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { contar(e.target as HTMLElement); io.unobserve(e.target); } }), { threshold: .5 });
    document.querySelectorAll<HTMLElement>('[data-contar]').forEach((el) => io.observe(el));
  </script>
</Base>
