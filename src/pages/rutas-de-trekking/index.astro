---
import Base from '../../layouts/Base.astro';
import Heroe from '../../components/Heroe.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Filtros from '../../components/Filtros.astro';
import Icono from '../../components/Icono.astro';
import { rutas, url, unicos, NIVELES, NIVEL_COLOR } from '../../scripts/datos';
const img = '/media/slider2/11melipeuco32-jpeg.webp';
const conteo = Object.fromEntries(NIVELES.map((n) => [n, rutas.filter((r) => r.interes === n).length]));
---
<Base titulo="Rutas de Trekking" zona="rutas" descripcion={`${rutas.length} rutas de trekking en Melipeuco: volcanes, lagunas, glaciares y bosques de araucarias.`} imagen={img}>
  <Heroe titulo="Vive la aventura" destacado="en cada paso" zona="rutas" imagen={img} migas={[{ texto: 'Rutas de trekking' }]}
    bajada={`${rutas.length} senderos para todos los niveles, desde paseos familiares hasta travesías glaciares.`}>
    <div class="acciones"><a class="btn btn--crema" href="/mapa/"><Icono nombre="mapa" /> Ver en el mapa</a></div>
  </Heroe>
  <section class="seccion" style="padding-top:40px">
    <div class="contenedor">
      <Filtros contenedor="lista-rutas" letra={0} opciones={[
        { clave: 'interes', etiqueta: 'Nivel', valores: [...NIVELES], tipo: 'pildoras', colores: NIVEL_COLOR, conteo },
        { clave: 'dificultad', etiqueta: 'Dificultad MIDE', valores: unicos(rutas.map((r) => r.dificultad)) },
        { clave: 'recorrido', etiqueta: 'Tipo de recorrido', valores: unicos(rutas.flatMap((r) => r.tipo_recorrido)) },
        { clave: 'condicion', etiqueta: 'Condición', valores: unicos(rutas.map((r) => r.condicion)) },
      ]} />
      <div class="grilla" id="lista-rutas">
        {rutas.map((r, i) => (
          <Tarjeta url={url.ruta(r.slug)} titulo={r.titulo} imagen={r.imagen} texto={r.extracto} letra={0} d={i}
            etiqueta={{ t: r.interes, c: NIVEL_COLOR[r.interes] }}
            chips={[r.extension && { t: r.extension }, r.duracion && { t: r.duracion }, r.dificultad && { t: `MIDE ${r.dificultad}` }].filter(Boolean) as { t: string }[]}
            filtros={{ interes: r.interes, dificultad: r.dificultad, recorrido: r.tipo_recorrido.join('|'), condicion: r.condicion.split(',').map((x) => x.trim()).join('|') }} />
        ))}
      </div>
    </div>
  </section>
</Base>
