---
import Base from '../layouts/Base.astro';
import Heroe from '../components/Heroe.astro';
import ListadoNegocios from '../components/ListadoNegocios.astro';
import { servicios, url } from '../scripts/datos';
const img = '/media/2024/11/47.labaita01-jpg.webp';
---
<Base titulo="Gastronomía" descripcion="Restaurantes, pastelerías y sabores locales de Melipeuco." imagen={img}>
  <Heroe titulo="Vive la" destacado="gastronomía" imagen={img} bajada="Cocina local, sabores mapuche, pastelería y heladería artesanal." />
  <section class="seccion"><div class="contenedor">
    <ListadoNegocios lista={servicios.filter((s) => s.seccion === 'gastronomia')} id="lista-gastronomia" enlace={url.servicio} icono="plato" filtro={{ clave: 'tipo', etiqueta: 'Tipo', campo: (n) => n.tipo ?? '' }} />
  </div></section>
</Base>
