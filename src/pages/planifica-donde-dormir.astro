---
import Base from '../layouts/Base.astro';
import Heroe from '../components/Heroe.astro';
import ListadoNegocios from '../components/ListadoNegocios.astro';
import { alojamientos, url } from '../scripts/datos';
const img = '/media/2024/11/huallerupelodge-3.jpg';
---
<Base titulo="Dónde dormir" zona="alojamientos" descripcion="Cabañas, hostales, lodges, bed & breakfast y camping en Melipeuco." imagen={img}>
  <Heroe titulo="Dónde" destacado="dormir" zona="alojamientos" imagen={img} migas={[{ texto: 'Dónde dormir' }]} bajada="Cabañas entre bosque nativo, hostales en el pueblo, lodges de montaña y camping bajo las estrellas." />
  <section class="seccion" style="padding-top:40px"><div class="contenedor">
    <ListadoNegocios lista={alojamientos} id="lista-alojamientos" enlace={url.alojamiento} letra={7} filtro={{ clave: 'clase', etiqueta: 'Tipo de alojamiento', campo: (n) => n.clase ?? '' }} />
  </div></section>
</Base>
