---
import FichaNegocio from '../../components/FichaNegocio.astro';
import { servicios, url, type Negocio } from '../../scripts/datos';
export function getStaticPaths() { return servicios.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props as { n: Negocio };
const gastro = n.seccion === 'gastronomia';
---
<FichaNegocio n={n} zona={gastro ? 'gastronomia' : 'complementarios'} propia={url.servicio(n.slug)} listado={gastro ? { url: '/gastronomia/', texto: 'Gastronomía' } : { url: '/complementarios/', texto: 'Servicios complementarios' }} />
