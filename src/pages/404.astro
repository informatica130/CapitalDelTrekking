---
import Base from '../layouts/Base.astro';
import Heroe from '../components/Heroe.astro';
import Icono from '../components/Icono.astro';
---
<Base titulo="Página no encontrada" zona="explora">
  <Heroe titulo="Te saliste" destacado="del sendero" zona="explora" imagen="/media/slider2/11melipeuco32-jpeg.webp" bajada="La página que buscas no existe o cambió de lugar.">
    <div class="acciones">
      <a class="btn btn--crema" href="/">Volver al inicio</a>
      <button class="btn btn--borde" type="button" data-buscar-abrir><Icono nombre="buscar" /> Buscar en el sitio</button>
    </div>
  </Heroe>
</Base>
