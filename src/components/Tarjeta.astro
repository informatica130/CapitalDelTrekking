---
import Icono from './Icono.astro';
import Emblema from './Emblema.astro';
interface Props {
  url: string; titulo: string; imagen?: string; texto?: string; letra?: number; color?: string;
  chips?: { t: string; c?: string }[]; etiqueta?: { t: string; c?: string }; filtros?: Record<string, string>; d?: number; fav?: boolean;
}
const { url, titulo, imagen, texto, letra = 0, color, chips = [], etiqueta, filtros = {}, d = 0, fav = true } = Astro.props;
const data = Object.fromEntries(Object.entries(filtros).map(([k, v]) => [`data-${k}`, v]));
---
<a href={url} class="tarjeta revelar" data-item data-tilt="5" style={`--d:${d % 4};${color ? `--c:${color}` : ''}`} {...data}>
  <div class="tarjeta__img">
    {imagen ? <img src={imagen} alt="" loading="lazy" decoding="async" /> : <div class="tarjeta__sinfoto"><Emblema letra={letra} /></div>}
    <div class="tarjeta__arriba">
      {etiqueta ? <span class="chip chip--solido" style={etiqueta.c ? `--c:${etiqueta.c}` : ''}>{etiqueta.t}</span> : <span></span>}
      {fav && <button type="button" class="fav" data-fav={url} aria-pressed="false" aria-label="Guardar en Mi viaje"><Icono nombre="corazon" /></button>}
    </div>
  </div>
  <div class="tarjeta__cuerpo">
    <h3>{titulo}</h3>
    {texto && <p>{texto}</p>}
    {chips.length > 0 && <div class="tarjeta__meta">{chips.map((c) => <span class="chip" style={c.c ? `--c:${c.c}` : ''}>{c.t}</span>)}</div>}
  </div>
  <span class="tarjeta__ir" aria-hidden="true"><Icono nombre="flecha" /></span>
  <span class="tarjeta__brillo" aria-hidden="true"></span>
</a>
