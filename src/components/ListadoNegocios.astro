---
import Tarjeta from './Tarjeta.astro';
import Filtros from './Filtros.astro';
import { unicos, type Negocio } from '../scripts/datos';
interface Props { lista: Negocio[]; id: string; enlace: (s: string) => string; letra: number; filtro?: { clave: string; etiqueta: string; campo: (n: Negocio) => string } }
const { lista, id, enlace, letra, filtro } = Astro.props;
const partes = (v: string) => (v ?? '').split(',').map((x) => x.trim()).filter(Boolean);
const valores = filtro ? unicos(lista.map(filtro.campo)) : [];
const conteo = filtro ? Object.fromEntries(valores.map((v) => [v, lista.filter((n) => partes(filtro.campo(n)).includes(v)).length])) : {};
---
<Filtros contenedor={id} letra={letra} opciones={filtro ? [{ clave: filtro.clave, etiqueta: filtro.etiqueta, valores, tipo: 'pildoras', conteo }] : []} />
<div class="grilla" id={id}>
  {lista.map((n, i) => {
    const v = filtro ? filtro.campo(n) : '';
    const p = partes(v);
    return (
      <Tarjeta url={enlace(n.slug)} titulo={n.titulo} imagen={n.imagen} texto={n.extracto} letra={letra} d={i}
        etiqueta={p[0] ? { t: p[0] } : undefined} chips={p.slice(1).map((t) => ({ t }))}
        filtros={filtro ? { [filtro.clave]: p.join('|') } : {}} />
    );
  })}
</div>
