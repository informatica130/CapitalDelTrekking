---
interface Props { imagenes: string[]; titulo?: string }
const { imagenes, titulo = '' } = Astro.props;
---
{imagenes.length > 0 && (
  <div class="galeria" data-galeria>
    {imagenes.map((src, i) => (
      <a href={src} data-indice={i} aria-label={`Ver foto ${i + 1} de ${imagenes.length}`}>
        <img src={src} alt={titulo ? `${titulo} — foto ${i + 1}` : ''} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
)}
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Galería de fotos" hidden>
  <button class="cerrar" aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  <button class="ant" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 6-6 6 6 6"/></svg></button>
  <img alt="" />
  <button class="sig" aria-label="Siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg></button>
  <span class="contador"></span>
</div>
<script>
  const lb = document.getElementById('lightbox') as HTMLDivElement | null;
  const gal = document.querySelector<HTMLElement>('[data-galeria]');
  if (lb && gal) {
    const enlaces = [...gal.querySelectorAll<HTMLAnchorElement>('a')];
    const img = lb.querySelector('img')!;
    const cont = lb.querySelector('.contador')!;
    let i = 0;
    const mostrar = (n: number) => {
      i = (n + enlaces.length) % enlaces.length;
      img.src = enlaces[i].href;
      cont.textContent = `${i + 1} / ${enlaces.length}`;
    };
    const abrir = (n: number) => { mostrar(n); lb.hidden = false; lb.classList.add('abierto'); document.body.style.overflow = 'hidden'; };
    const cerrar = () => { lb.classList.remove('abierto'); lb.hidden = true; document.body.style.overflow = ''; };
    enlaces.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); abrir(n); }));
    lb.querySelector('.cerrar')!.addEventListener('click', cerrar);
    lb.querySelector('.ant')!.addEventListener('click', () => mostrar(i - 1));
    lb.querySelector('.sig')!.addEventListener('click', () => mostrar(i + 1));
    lb.addEventListener('click', (e) => { if (e.target === lb) cerrar(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') cerrar();
      if (e.key === 'ArrowLeft') mostrar(i - 1);
      if (e.key === 'ArrowRight') mostrar(i + 1);
    });
  }
</script>
