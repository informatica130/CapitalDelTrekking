---
import Icono from './Icono.astro';
interface Props { imagenes: string[]; titulo?: string }
const { imagenes, titulo = '' } = Astro.props;
---
{imagenes.length > 0 && (
  <div class="galeria" data-galeria>
    {imagenes.map((src, i) => (
      <a href={src} class="revelar revelar--cortina" style={`transition-delay:${(i % 6) * 70}ms`} aria-label={`Ver foto ${i + 1} de ${imagenes.length}`}>
        <img src={src} alt={titulo ? `${titulo} — foto ${i + 1}` : ''} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
)}
<div class="visor" id="visor" role="dialog" aria-modal="true" aria-label="Galería de fotos">
  <button class="cerrar" aria-label="Cerrar"><Icono nombre="cerrar" /></button>
  <button class="ant" aria-label="Anterior"><Icono nombre="izq" /></button>
  <img alt="" />
  <button class="sig" aria-label="Siguiente"><Icono nombre="der" /></button>
  <span class="contador"></span>
</div>
<script>
  const visor = document.getElementById('visor');
  const gal = document.querySelector<HTMLElement>('[data-galeria]');
  if (visor && gal) {
    const enlaces = [...gal.querySelectorAll<HTMLAnchorElement>('a')];
    const img = visor.querySelector('img')!;
    const cont = visor.querySelector('.contador')!;
    let i = 0, x0 = 0;
    const mostrar = (n: number) => { i = (n + enlaces.length) % enlaces.length; img.src = enlaces[i].href; cont.textContent = `${i + 1} / ${enlaces.length}`; };
    const abrir = (n: number) => { mostrar(n); visor.classList.add('abierto'); document.body.classList.add('bloqueo'); };
    const cerrar = () => { visor.classList.remove('abierto'); document.body.classList.remove('bloqueo'); };
    enlaces.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); abrir(n); }));
    visor.querySelector('.cerrar')!.addEventListener('click', cerrar);
    visor.querySelector('.ant')!.addEventListener('click', () => mostrar(i - 1));
    visor.querySelector('.sig')!.addEventListener('click', () => mostrar(i + 1));
    visor.addEventListener('click', (e) => { if (e.target === visor) cerrar(); });
    visor.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    visor.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) mostrar(i + (dx < 0 ? 1 : -1)); });
    document.addEventListener('keydown', (e) => {
      if (!visor.classList.contains('abierto')) return;
      if (e.key === 'Escape') cerrar();
      if (e.key === 'ArrowLeft') mostrar(i - 1);
      if (e.key === 'ArrowRight') mostrar(i + 1);
    });
  }
</script>
