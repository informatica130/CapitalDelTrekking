---
import Icono from './Icono.astro';
interface Props { gpx?: string; coords?: [number, number] | null; titulo: string }
const { gpx = '', coords, titulo } = Astro.props;
const destino = coords ? `https://www.google.com/maps/dir/?api=1&destination=${coords[0]},${coords[1]}` : '';
---
<div class="mapa" id="mapaRuta" data-gpx={gpx} data-lat={coords?.[0]} data-lng={coords?.[1]} data-titulo={titulo} role="region" aria-label={`Mapa de ${titulo}`}></div>
{gpx && (
  <div class="perfil" id="perfil" hidden>
    <div class="perfil__cab"></div>
    <svg viewBox="0 0 800 200" preserveAspectRatio="none" role="img" aria-label="Perfil de elevación">
      <defs>
        <linearGradient id="gradPerfil" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#1f4a33" stop-opacity=".55" />
          <stop offset="1" stop-color="#1f4a33" stop-opacity=".05" />
        </linearGradient>
      </defs>
      <g class="eje"></g><path class="area" /><path class="linea" /><line class="cursor" y1="0" y2="200" visibility="hidden" />
    </svg>
  </div>
)}
<div class="acciones-mapa">
  {destino && <a class="btn btn--verde" href={destino} target="_blank" rel="noopener"><Icono nombre="coche" /> Cómo llegar</a>}
  {gpx && <a class="btn btn--borde" style="color:var(--bosque)" href={gpx} download><Icono nombre="descarga" /> Descargar track GPX</a>}
</div>
<script>
  import L from 'leaflet';
  import { crearMapa, pin } from '../scripts/mapa-base';
  import { leerGpx, resumen, type Punto } from '../scripts/gpx';

  const el = document.getElementById('mapaRuta');
  if (el) {
    const lat = parseFloat(el.dataset.lat ?? ''), lng = parseFloat(el.dataset.lng ?? '');
    const centro: [number, number] | undefined = Number.isNaN(lat) ? undefined : [lat, lng];
    const mapa = crearMapa(el, centro, 12);
    if (centro) L.marker(centro, { icon: pin('#f3b229', 20) }).addTo(mapa).bindPopup(`<b>${el.dataset.titulo}</b><br>Punto de inicio`);

    const gpx = el.dataset.gpx;
    if (gpx) {
      leerGpx(gpx).then((segs) => {
        if (!segs.length) return;
        const capa = L.featureGroup(segs.map((s) => L.polyline(s.map((p) => [p.lat, p.lng]), { color: '#f3b229', weight: 5, opacity: .95 }))).addTo(mapa);
        L.featureGroup(segs.map((s) => L.polyline(s.map((p) => [p.lat, p.lng]), { color: '#17191b', weight: 9, opacity: .35 }))).addTo(mapa).bringToBack();
        mapa.fitBounds(capa.getBounds(), { padding: [30, 30] });
        dibujarPerfil(segs.flat(), mapa);
      }).catch(() => {});
    }
  }

  function dibujarPerfil(pts: Punto[], mapa: L.Map) {
    const caja = document.getElementById('perfil');
    const conEle = pts.filter((p) => p.ele !== null);
    if (!caja || conEle.length < 5) return;
    caja.hidden = false;
    const r = resumen(pts);
    caja.querySelector('.perfil__cab')!.innerHTML =
      `<span>Distancia del track: <b>${r.km.toFixed(1)} km</b></span>` +
      `<span>Ascenso acumulado: <b>${Math.round(r.sube)} m</b></span>` +
      `<span>Descenso acumulado: <b>${Math.round(r.baja)} m</b></span>` +
      `<span>Altitud mín / máx: <b>${Math.round(r.min!)} – ${Math.round(r.max!)} m</b></span>`;
    const W = 800, H = 200, pad = 26;
    const total = conEle.at(-1)!.dist - conEle[0].dist || 1;
    const lo = r.min! - 20, hi = r.max! + 20;
    const x = (d: number) => ((d - conEle[0].dist) / total) * W;
    const y = (e: number) => H - pad - ((e - lo) / (hi - lo)) * (H - pad - 8);
    const linea = conEle.map((p, i) => `${i ? 'L' : 'M'}${x(p.dist).toFixed(1)},${y(p.ele!).toFixed(1)}`).join('');
    const svg = caja.querySelector('svg')!;
    svg.querySelector('.linea')!.setAttribute('d', linea);
    svg.querySelector('.area')!.setAttribute('d', `${linea}L${W},${H - pad}L0,${H - pad}Z`);
    const eje = svg.querySelector('.eje')!;
    let marcas = '';
    for (let k = 0; k <= 4; k++) {
      const e = lo + ((hi - lo) * k) / 4, yy = y(e);
      marcas += `<line x1="0" x2="${W}" y1="${yy}" y2="${yy}"/><text x="4" y="${yy - 3}">${Math.round(e)} m</text>`;
    }
    eje.innerHTML = marcas;
    const cursor = svg.querySelector('.cursor')!;
    const marcador = L.circleMarker([conEle[0].lat, conEle[0].lng], { radius: 7, color: '#fff', fillColor: '#1f4a33', fillOpacity: 1, weight: 3 });
    svg.addEventListener('mousemove', (ev) => {
      const b = svg.getBoundingClientRect();
      const d = conEle[0].dist + ((ev.clientX - b.left) / b.width) * total;
      let p = conEle[0];
      for (const q of conEle) { if (q.dist >= d) { p = q; break; } }
      cursor.setAttribute('x1', String(x(p.dist))); cursor.setAttribute('x2', String(x(p.dist)));
      cursor.setAttribute('visibility', 'visible');
      marcador.setLatLng([p.lat, p.lng]).addTo(mapa);
      marcador.bindTooltip(`${Math.round(p.ele!)} m · km ${(p.dist / 1000).toFixed(1)}`, { permanent: true, direction: 'top', offset: [0, -8] }).openTooltip();
    });
    svg.addEventListener('mouseleave', () => { cursor.setAttribute('visibility', 'hidden'); marcador.remove(); });
  }
</script>
