---
import Tarjeta from './Tarjeta.astro';
import Filtros from './Filtros.astro';
import { actividades, url, unicos } from '../scripts/datos';
interface Props { categoria: 'actividad' | 'atractivo' }
const { categoria } = Astro.props;
const lista = actividades.filter((a) => a.categoria === categoria);
const id = `lista-${categoria}`;
const letra = categoria === 'actividad' ? 2 : 3;
const tipos = unicos(lista.map((a) => a.tipo));
const conteo = Object.fromEntries(tipos.map((t) => [t, lista.filter((a) => a.tipo.split(',').map((x) => x.trim()).includes(t)).length]));
---
<Filtros contenedor={id} letra={letra} opciones={[{ clave: 'tipo', etiqueta: categoria === 'actividad' ? 'Tipo de actividad' : 'Tipo de atractivo', valores: tipos, tipo: 'pildoras', conteo }]} />
<div class="grilla" id={id}>
  {lista.map((a, i) => (
    <Tarjeta url={url.actividad(a.slug)} titulo={a.titulo} imagen={a.imagen} texto={a.extracto} letra={letra} d={i}
      etiqueta={a.tipo ? { t: a.tipo } : undefined} filtros={{ tipo: a.tipo.split(',').map((x) => x.trim()).join('|') }} />
  ))}
</div>
